(version 1)

(rule "INA333_DGK_U301_U401_internal_adjacent_pads_0p20mm"
	(constraint clearance (min 0.200mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.Reference == 'U301' && B.Reference == 'U301') || (A.Reference == 'U401' && B.Reference == 'U401')) && (((A.Pad_Number == '1' && B.Pad_Number == '2') || (A.Pad_Number == '2' && B.Pad_Number == '1')) || ((A.Pad_Number == '2' && B.Pad_Number == '3') || (A.Pad_Number == '3' && B.Pad_Number == '2')) || ((A.Pad_Number == '3' && B.Pad_Number == '4') || (A.Pad_Number == '4' && B.Pad_Number == '3')) || ((A.Pad_Number == '5' && B.Pad_Number == '6') || (A.Pad_Number == '6' && B.Pad_Number == '5')) || ((A.Pad_Number == '6' && B.Pad_Number == '7') || (A.Pad_Number == '7' && B.Pad_Number == '6')) || ((A.Pad_Number == '7' && B.Pad_Number == '8') || (A.Pad_Number == '8' && B.Pad_Number == '7')))")
)
